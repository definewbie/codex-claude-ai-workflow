<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.4</version>
        <relativePath/>
    </parent>

    <groupId>dev.dual</groupId>
    <artifactId>dual-orchestrator</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>dual-orchestrator</name>
    <description>Lifecycle orchestrator for Claude/Codex dual-agent workflows.</description>

    <modules>
        <module>dual-core</module>
        <module>dual-ledger-file</module>
        <module>dual-flow-liteflow</module>
        <module>dual-runtime</module>
        <module>dual-adapter-acpx</module>
        <module>dual-adapter-git</module>
        <module>dual-cli</module>
        <module>dual-server</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <picocli.version>4.7.6</picocli.version>
        <liteflow.version>2.16.0</liteflow.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli</artifactId>
                <version>${picocli.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yomahub</groupId>
                <artifactId>liteflow-core</artifactId>
                <version>${liteflow.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
