igDecimal(\"0.008\"))));\n83\t        AssessIncomeCliRunner runner = new AssessIncomeCliRunner(\n84\t                service, new PrintStream(bytes, true, StandardCharsets.UTF_8));\n85\t        runner.run(new DefaultApplicationArguments(arguments));\n86\t        return new Invocation(runner.getExitCode(), bytes.toString(StandardCharsets.UTF_8));\n87\t    }\n88\t\n89\t    private static String[] completeArgu..."},"output":"1\tpackage app.cryptoincome.cli;\n2\t\n3\timport app.cryptoincome.assessment.application.PhaseOneAssessmentService;\n4\timport app.cryptoincome.assessment.domain.FundingRatePoint;\n5\timport org.junit.jupiter.api.Test;\n6\timport org.springframework.boot.DefaultApplicationArguments;\n7\t\n8\timport java.io.ByteArrayOutputStream;\n9\timport java.io.PrintStream;\n10\timport java.math.BigDecimal;\n11\timport java.nio.charset.StandardCharsets;\n12\timport java.time.Instant;\n13\timport java.util.Arrays;\n14\timport java.util.List;\n15\t\n16\timport static org.assertj.core.api.Assertions.assertThat;\n17\t\n18\tclass AssessIncomeCliRunnerTest {\n19\t\n20\t    @Test\n21\t    void printsTypedChineseRecommendationAndNeverSuggestsMoreThanMicroValidation() {\n22\t        var invocation = invoke(completeArguments());\n23\t\n24\t        assertThat(invocation.exitCode()).isZero();\n25\t        assertThat(invocation.output())\n26\t                .contains(\"第一期收益评估\")\n27\t                .contains(\"简单赚币90天收益=172.60 USDT\")\n28\t                .contains(\"简单赚币报价来源=OKX确认页\")\n29\t                .contains(\"成本输入来源=OKX预览+用户假设\")\n30\t                .contains(\"建议=仅小额验证智能套利\")\n31\t                .contains(\"首次实盘上限=5000.00 USDT\")\n32\t                .contains(\"区间完整性尚未证明\")\n33\t                .doesNotContain(\"200000 USDT\");\n34\t    }\n35\t\n36\t    @Test\n37\t    void missingCostsRemainUnknownAndDoNotPrintExactNetIncome() {\n38\t        String[] withoutExitAndSlippage = Arrays.stream(completeArguments())\n39\t                .filter(value -> !value.equal