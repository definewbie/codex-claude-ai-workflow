va/app/cryptoincome/assessment/domain/EvidenceStatus.java","is_error":false,"content":{"Text":"1\tpackage app.cryptoincome.assessment.domain;\n2\t\n3\tpublic enum EvidenceStatus {\n4\t    SUFFICIENT_FOR_COMPARISON,\n5\t    SUFFICIENT_FOR_MICRO_VALIDATION,\n6\t    INSUFFICIENT\n7\t}\n8\t"},"output":"1\tpackage app.cryptoincome.assessment.domain;\n2\t\n3\tpublic enum EvidenceStatus {\n4\t    SUFFICIENT_FOR_COMPARISON,\n5\t    SUFFICIENT_FOR_MICRO_VALIDATION,\n6\t    INSUFFICIENT\n7\t}\n8\t"},"call_492dab5c98f14a21b86003a1":{"tool_use_id":"call_492dab5c98f14a21b86003a1","tool_name":"Read src/main/java/app/cryptoincome/assessment/domain/Recommendation.java","is_error":false,"content":{"Text":"1\tpackage app.cryptoincome.assessment.domain;\n2\t\n3\tpublic enum Recommendation {\n4\t    INSUFFICIENT_EVIDENCE,\n5\t    PREFER_SIMPLE_EARN,\n6\t    WATCH_SMART_ARBITRAGE,\n7\t    MICRO_VALIDATE_ARBITRAGE\n8\t}\n9\t"},"output":"1\tpackage app.cryptoincome.assessment.domain;\n2\t\n3\tpublic enum Recommendation {\n4\t    INSUFFICIENT_EVIDENCE,\n5\t    PREFER_SIMPLE_EARN,\n6\t    WATCH_SMART_ARBITRAGE,\n7\t    MICRO_VALIDATE_ARBITRAGE\n8\t}\n9\t"},"call_62ce270171254e38ac0d2a03":{"tool_use_id":"call_62ce270171254e38ac0d2a03","tool_name":"Read src/main/java/app/cryptoincome/assessment/domain/OpeningCost.java","is_error":false,"content":{"Text":"1\tpackage app.cryptoincome.assessment.domain;\n2\t\n3\timport java.math.BigDecimal;\n4\timport java.util.Objects;\n5\t\n6\t/** 开仓成本只能选择聚合值或明细值，类型本身阻止重复扣减。 */\n7\tpublic sealed interface OpeningCost permits OpeningCost.Aggregate, OpeningCost.Components {\n8\t\n9\t    BigDecimal amount();\n10\t\n11\t    record Aggregate(BigDecimal amount) implements OpeningCost {\n12\t        public Aggregate {\n13\t            amount = requireCost(amount, \"开仓聚合成本\");\n14\t        }\n15\t    }\n16\t\n17\t    record Components(BigDecimal spreadCost, BigDecimal spotFee, BigDecimal perpetualFee)\n18\t            implements OpeningCost {\n19\t        public Components {\n20\t            spreadCost = requireCost(spreadCost, \"开仓价差成本\");\n21\t            spotFee = requireCost(spotFee, \"现货开仓手续费\");\n22\t            perpetualFee = requireCost(perpetualFee, \"合约开仓手续费\");\n23\t        }\n24\t\n25\t        @Override\n26\t        public BigDecimal amount() {\n27\t            return spreadCost.add(spotFee).add(perpetualFee);\n28\t        }\n29\t    }\n30\t\n31\t    private static BigDecimal requireCost(BigDecimal value, String name) {\n32\t        Objects.requireNonNull(value, name + \"不能为空\");\n33\t        if (value.signum() < 0) {\n34\t            throw new IllegalArgumentException(name + \"不能为负数\");\n35\t        }\n36\t        return value;\n37\t    }\n38\t}\n39\t"},"output":"1\tpackage app.cryptoincome.assessment.domain;\n2\t\n3\timport java.math.BigDecimal;\n4\timport java.util.Objects;\n5\t\n6\t/** 开仓成本只能选择聚合值或明细值，类型本身阻止重复扣减。 */\n7\tpublic sealed interface OpeningCost permits OpeningCost.Aggregate, OpeningCost.Components {\n8\t\n9\t    BigDecimal amount();\n10\t\n11\t    record Aggregate(BigDecimal amount) implements OpeningCost {\n12\t        public Aggregate {\n13\t            amount = requireCost(amount, \"开仓聚合成本\");\n14\t        }\n15\t    }\n16\t\n17\t    record Components(BigDecimal spreadCost, BigDecimal spotFee, BigDecimal perpetualFee)\n18\t            implements OpeningCost {\n19\t        public Components {\n20\t            spreadCost = requireCost(spreadCost, \"开仓价差成本\");\n21\t            spotFee = requireCost(spotFee, \"现货开仓手续费\");\n22\t            perpetualFee = requireCost(perpetualFee, \"合约开仓手续费\");\n23\t        }\n24\t\n25\t        @Override\n26\t        public BigDecimal amount() {\n27\t            return spreadCost.add(spotFee).add(perpetualFee);\n28\t        }\n29\t    }\n30\t\n31\t    private static BigDecimal requireCost(BigDecimal value, String name) {\n32\t        Objects.requireNonNull(value, name + \"不能为空\");\n33\t        if (value.signum() < 0) {\n34\t            throw new IllegalArgumentException(name + \"不能为负数\");\n35\t        }\n36\t        return value;\n37\t    }\n38\t}\n39\t"},"call_87fb54dc999247219c071890":{"tool_use_id":"call_87fb54dc999247219c071890","tool_name":"Read .agent/workstreams/ws-20261026T142203Z-7SNA/artifacts/contracts/node-contract-compile-007/task-contract.md","is_error":false,"content":{"Text":"1\t# Task Contract\n2\t\n3\t## Objective\n4\t\n5\t在既有 Java 项目 assess-income phase-one 的 90 天历史情景评估中新增可解释指标：在相同 90 天窗口、投入资金、对冲空头名义金额和固定已知成本口径下，资金费净收入追平简单赚币所需的整个 90 天累计资金费率阈值，由 PhaseOneAssessmentService 计算、PhaseOneAssessment record 承载、CLI 只读展示，并保留证据不足时的不可用语义。\n6\t\n7\t## Scope\n8\t\n9\t**Excluded:**\n10\t- 不修改交易/账户、采集（sync-market/sync-product）、数据库迁移、持仓、调度、组合策略、Web 页面、Dual 生产代码或客户端配置\n11\t- 不接入任何新外部服务，不做未来费率预测或交易建议\n12\t- 不做整个项目的公式重构，不新增平台、规则 DSL 或兼容机制\n13\t\n14\t## Acceptance Criteria\n15\t\n16\t- [ ] AC-1: 计算口径：阈值 =（既有简单赚币 90 天收入 + 同口径完整已知成本）/ 对冲空头名义金额；该值是整个 90 天窗口的累计资金费率，不是 APR，不得按每次结算或假定 8 小时间隔换算；成本沿用 SmartArbitrageCosts.knownTotal() 既有口径，不重复计费；计算使用 BigDecimal 且精度规则明确（与既有服务的 DECIMAL128 计算上下文一致，除法精度显式声明）。\n17\t- [ ] AC-2: 独立样例与边界：共同资金 20,000 USDT、简单赚币 APR 0.0365、90 天、完整成本 20 USDT、对冲名义 10,000 USDT 时，对照收益为 180 USDT、阈值为 0.02（2%）；累计费率分别为 0.019、0.020、0.021 时，现有同口径增量分别为 -10、0、10 USDT；测试同时覆盖零已知成本、零 APR、负资金费率以及不能整除的精度场景；不得用舍入后的 CLI 数字重新决定现有建议。\n18\t- [ ] AC-3: 证据不足：只在现有评估允许同口径精确净收入比较时提供数值；成本缺失、简单赚币条款未确认、窗口内无历史结算或期末保持策略开放时数值不可用，并沿既有阻断项/未知项说明原因，不得填 0、猜数或给出可行动的精确阈值；非法或零名义金额沿 PhaseOneAssessmentRequest 既有输入校验拒绝（hedgedShortNotional 必须大于 0）。\n19\t- [ ] AC-4: 唯一生产与展示：现有评估服务产生 typed 结果（阈值作为 PhaseOneAssessment 的字段），CLI 只消费该结果，清楚标注“90 天累计资金费率阈值”及不可用情况，不自行重算；补充一份简明中文使用说明，包含上述样例和限制；既有建议、首次小额验证上限（5,000 USDT）、成本和风险语义不变。\n20\t- [ ] AC-5: 回归与交付：在固定隔离基线（当前分支 codex/w09-okx-break-even-20261026 @ 7c5facc）上实现；相关服务/CLI 测试、既有非容器回归和 Gate 要求的完整基线回归保留并通过，执行测试有程序工具观察和报告依据（如 Maven Surefire 报告），不能只以模型“已通过”正文作数；独立验收完成后，仍需当前交付批准、精确候选应用、人工或另行明确委派的 commit、原 finalize，才能称完整 E2E 完成。\n21\t\n22\t## Test Requirements\n23\t\n24\t- TR-1: PhaseOneAssessmentServiceTest 增加阈值单元测试：验证 AC-2 样例（对照收益 180 USDT、阈值 0.02）与累计费率 0.019/0.020/0.021 对应既有同口径增量 -10/0/+10 USDT，并覆盖零已知成本、零 APR、负资金费率和除不尽的精度场景；断言基于 BigDecimal 原值而非 CLI 舍入输出。\n25\t- TR-2: PhaseOneAssessmentServiceTest 增加不可用与校验测试：成本缺失、条款未确认、无历史结算、期末保持策略开放时阈值为空且原因沿既有 blockers/unknowns 输出；非法或零对冲名义金额在读取事实前被既有请求校验拒绝。\n26\t- TR-3: AssessIncomeCliRunnerTest 增加展示测试：完整证据时输出含“90 天累计资金费率阈值”标签及数值，证据不足时输出不可用说明且不打印数值；既有建议文案、首次实盘上限、退出码与限制提示不回归。\n27\t- TR-4: 在固定隔离基线上运行既有非容器回归和 Gate 要求的完整基线回归（mvn 测试），以 Maven/Surefire 等程序工具生成的报告作为通过依据，并保留完整基线通过事实。\n28\t\n29\t## Constraints\n30\t\n31\t- 继续使用现有 Java、BigDecimal、PhaseOneAssessmentService 评估服务和 assess-income CLI，不接入任何新外部服务或数据源。\n32\t- 阈值是整个 90 天窗口的累计资金费率，禁止换算成 APR 或按每次结算/假定 8 小时间隔折算；资金费间隔遵循实际 fundingTime。\n33\t- 成本口径沿用 SmartArbitrageCosts.knownTotal() 既有实现，不重复计费、不改变未知成本按 UNKNOWN 处理的语义；阈值的可用条件与既有增量比较的可用条件一致。\n34\t- 单一生产来源：阈值只在 PhaseOneAssessmentService 内计算并作为 typed 字段返回；CLI 是薄适配层，只打印该结果，不重算、不用舍入值影响建议。\n35\t- 资金费事实表、数据库迁移、同步/回补、组合策略与 Web 输出保持不动（只读）；新增说明文档为中文，沿用 docs 目录编号惯例。\n36\t- 精度规则显式：服务层计算与既有 CALCULATION_CONTEXT（MathContext.DECIMAL128）一致且除法上下文明确，展示层沿用 CLI 既有格式化惯例并标注为累计费率而非年化。\n37\t\n38\t## Non-Goals\n39\t\n40\t- 不做未来资金费率预测、完整套利收益保证或交易建议；阈值仅用于历史情景比较，既有未覆盖风险与历史完整性限制继续保留。\n41\t- 不修改交易/账户、采集、数据库迁移、持仓、调度、组合策略、Web 页面、Dual 生产代码或客户端配置。\n42\t- 不把收益阈值推广为整个项目的公式重构，不新增平台、规则 DSL 或兼容机制。\n43\t- 不改变既有建议逻辑、首次小额验证上限（5,000 USDT）、成本与风险/限制提示语义。\n44\t- 发现实现依赖超出上述范围（如需要改迁移、Web 或组合代码）时停止并提交取舍，不擅自扩大实现。\n45\t\n46\t## Risk Areas\n47\t\n48\t- 阈值展示格式（小数位/百分比）需要在设计评审确定，避免被误读为 APR 或单次费率；服务层核心值保持 DECIMAL128 不预先舍入。\n49\t- 为 PhaseOneAssessment record 新增字段会改变构造签名，当前构造点仅在 PhaseOneAssessmentService，需在执行时确认无其他调用点遗漏。\n50\t- 新说明文档建议命名 docs/15-Funding-Rate-Break-Even-Threshold.md（沿用 docs 01–14 编号惯例），最终路径以 EXECUTION 批准的精确 scope 为准。\n51\t\n52\t## Evidence References\n53\t\n54\t- src/main/java/app/cryptoincome/assessment/application/PhaseOneAssessmentService.java\n55\t- src/main/java/app/cryptoincome/assessment/domain/PhaseOneAssessment.java\n56\t- src/main/java/app/cryptoincome/assessment/domain/PhaseOneAssessmentRequest.java\n57\t- src/main/java/app/cryptoincome/assessment/domain/SmartArbitrageCosts.java\n58\t- src/main/java/app/cryptoincome/cli/AssessIncomeCliRunner.java\n59\t- src/test/java/app/cryptoincome/assessment/PhaseOneAssessmentServiceTest.java\n60\t- src/test/java/app/cryptoincome/cli/AssessIncomeCliRunnerTest.java\n61\t- docs/09-Phase-1-Test-Runbook.md\n62\t\n63\t## Nonessential Operation Declarations\n64\t\n65\t- None\n66\t\n67\t## Source\n68\t\n69\t- **Created by:*..."},"output":"1\t# Task Contract\n2\t\n3\t## Objective\n4\t\n5\t在既有 Java 项目 assess-income phase-one 的 90 天历史情景评估中新增可解释指标：在相同 90 天窗口、投入资金、对冲空头名义金额和固定已知成本口径下，资金费净收入追平简单赚币所需的整个 90 天累计资金费率阈值，由 PhaseOneAssessmentService 计算、PhaseOneAssessment record 承载、CLI 只读展示，并保留证据不足时的不可用语义。\n6\t\n7\t## Scope\n8\t\n9\t**Excluded:**\n10\t- 不修改交易/账户、采集（sync-market/sync-product）、数据库迁移、持仓、调度、组合策略、Web 页面、Dual 生产代码或客户端配置\n11\t- 不接入任何新外部服务，不做未来费率预测或交易建议\n12\t- 不做整个项目的公式重构，不新增平台、规则 DSL 或兼容机制\n13\t\n14\t## Acceptance Criteria\n15\t\n16\t- [ ] AC-1: 计算口径：阈值 =（既有简单赚币 90 天收入 + 同口径完整已知成本）/ 对冲空头名义金额；该值是整个 90 天窗口的累计资金费率，不是 APR，不得按每次结算或假定 8 小时间隔换算；成本沿用 SmartArbitrageCosts.knownTotal() 既有口径，不重复计费；计算使用 BigDecimal 且精度规则明确（与既有服务的 DECIMAL128 计算上下文一致，除法精度显式声明）。\n17\t- [ ] AC-2: 独立样例与边界：共同资金 20,000 USDT、简单赚币 APR 0.0365、90 天、完整成本 20 USDT、对冲名义 10,000 USDT 时，对照收益为 180 USDT、阈值为 0.02（2%）；累计费率分别为 0.019、0.020、0.021 时，现有同口径增量分别为 -10、0、10 USDT；测试同时覆盖零已知成本、零 APR、负资金费率以及不能整除的精度场景；不得用舍入后的 CLI 数字重新决定现有建议。\n18\t- [ ] AC-3: 证据不足：只在现有评估允许同口径精确净收入比较时提供数值；成本缺失、简单赚币条款未确认、窗口内无历史结算或期末保持策略开放时数值不可用，并沿既有阻断项/未知项说明原因，不得填 0、猜数或给出可行动的精确阈值；非法或零名义金额沿 PhaseOneAssessmentRequest 既有输入校验拒绝（hedgedShortNotional 必须大于 0）。\n19\t- [ ] AC-4: 唯一生产与展示：现有评估服务产生 typed 结果（阈值作为 PhaseOneAssessment 的字段），CLI 只消费该结果，清楚标注“90 天累计资金费率阈值”及不可用情况，不自行重算；补充一份简明中文使用说明，包含上述样例和限制；既有建议、首次小额验证上限（5,000 USDT）、成本和风险语义不变。\n20\t- [ ] AC-5: 回归与交付：在固定隔离基线（当前分支 codex/w09-okx-break-even-20261026 @ 7c5facc）上实现；相关服务/CLI 测试、既有非容器回归和 Gate 要求的完整基线回归保留并通过，执行测试有程序工具观察和报告依据（如 Maven Surefire 报告），不能只以模型“已通过”正文作数；独立验收完成后，仍需当前交付批准、精确候选应用、人工或另行明确委派的 commit、原 finalize，才能称完整 E2E 完成。\n21\t\n22\t## Test Requirements\n23\t\n24\t- TR-1: PhaseOneAssessmentServiceTest 增加阈值单元测试：验证 AC-2 样例（对照收益 180 USDT、阈值 0.02）与累计费率 0.019/0.020/0.021 对应既有同口径增量 -10/0/+10 USDT，并覆盖零已知成本、零 APR、负资金费率和除不尽的精度场景；断言基于 BigDecimal 原值而非 CLI 舍入输出。\n25\t- TR-2: PhaseOneAssessmentServiceTest 增加不可用与校验测试：成本缺失、条款未确认、无历史结算、期末保持策略开放时阈值为空且原因沿既有 blockers/unknowns 输出；非法或零对冲名义金额在读取事实前被既有请求校验拒绝。\n26\t- TR-3: AssessIncomeCliRunnerTest 增加展示测试：完整证据时输出含“90 天累计资金费率阈值”标签及数值，证据不足时输出不可用说明且不打印数值；既有建议文案、首次实盘上限、退出码与限制提示不回归。\n27\t- TR-4: 在固定隔离基线上运行既有非容器回归和 Gate 要求的完整基线回归（mvn 测试），以 Maven/Surefire 等程序工具生成的报告作为通过依据，并保留完整基线通过事实。\n28\t\n29\t## Constraints\n30\t\n31\t- 继续使用现有 Java、BigDecimal、PhaseOneAssessmentService 评估服务和 assess-income CLI，不接入任何新外部服务或数据源。\n32\t- 阈值是整个 90 天窗口的累计资金费率，禁止换算成 APR 或按每次结算/假定 8 小时间隔折算；资金费间隔遵循实际 fundingTime。\n33\t- 成本口径沿用 SmartArbitrageCosts.knownTotal() 既有实现，不重复计费、不改变未知成本按 UNKNOWN 处理的语义；阈值的可用条件与既有增量比较的可用条件一致。\n34\t- 单一生产来源：阈值只在 PhaseOneAssessmentService 内计算并作为 typed 字段返回；CLI 是薄适配层，只打印该结果，不重算、不用舍入值影响建议。\n35\t- 资金费事实表、数据库迁移、同步/回补、组合策略与 Web 输出保持不动（只读）；新增说明文档为中文，沿用 docs 目录编号惯例。\n36\t- 精度规则显式：服务层计算与既有 CALCULATION_CONTEXT（MathContext.DECIMAL128）一致且除法上下文明确，展示层沿用 CLI 既有格式化惯例并标注为累计费率而非年化。\n37\t\n38\t## Non-Goals\n39\t\n40\t- 不做未来资金费率预测、完整套利收益保证或交易建议；阈值仅用于历史情景比较，既有未覆盖风险与历史完整性限制继续保留。\n41\t- 不修改交易/账户、采集、数据库迁移、持仓、调度、组合策略、Web 页面、Dual 生产代码或客户端配置。\n42\t- 不把收益阈值推广为整个项目的公式重构，不新增平台、规则 DSL 或兼容机制。\n43\t- 不改变既有建议逻辑、首次小额验证上限（5,000 USDT）、成本与风险/限制提示语义。\n44\t- 发现实现依赖超出上述范围（如需要改迁移、Web 或组合代码）时停止并提交取舍，不擅自扩大实现。\n45\t\n46\t## Risk Areas\n47\t\n48\t- 阈值展示格式（小数位/百分比）需要在设计评审确定，避免被误读为 APR 或单次费率；服务层核心值保持 DECIMAL128 不预先舍入。\n49\t- 为 PhaseOneAssessment record 新增字段会改变构造签名，当前构造点仅在 PhaseOneAssessmentService，需在执行时确认无其他调用点遗漏。\n50\t- 新说明文档建议命名 docs/15-Funding-Rate-Break-Even-Threshold.md（沿用 docs 01–14 编号惯例），最终路径以 EXECUTION 批准的精确 scope 为准。\n51\t\n52\t## Evidence References\n53\t\n54\t- src/main/java/app/cryptoincome/assessment/application/PhaseOneAssessmentService.java\n55\t- src/main/java/app/cryptoincome/assessment/domain/PhaseOneAssessment.java\n56\t- src/main/java/app/cryptoincome/assessment/domain/PhaseOneAssessmentRequest.java\n57\t- src/main/java/app/cryptoincome/assessment/domain/SmartArbitrageCosts.java\n58\t- src/main/java/app/cryptoincome/cli/AssessIncomeCliRunner.java\n59\t- src/test/java/app/cryptoincome/assessment/PhaseOneAssessmentServiceTest.java\n60\t- src/test/java/app/cryptoincome/cli/AssessIncomeCliRunnerTest.java\n61\t- docs/09-Phase-1-Test-Runbook.md\n62\t\n63\t## Nonessential Operation Declarations\n64\t\n65\t- None\n66\t\n67\t## Source\n68\t\n69\t- **Created by:*..."},"call_cdd78c216f8346febb776577":{"tool_use_id":"call_cdd78c216f8346febb776577","tool_name":"Read .agent/workstreams/ws-20261026T142203Z-7SNA/artifacts/contracts/node-contract-compile-007/contract-resolution.md","is_error":false,"content":{"Text":"1\t# Contract Resolution\n2\t\n3\t- Decision: APPROVE\n4\t- Approved By: human_gate\n5\t- Gate Ref: .agent/workstreams/ws-20261026T142203Z-7SNA/gates/gate-node-gate-human_requirement_review-006.json\n6\t- Created At: 2026-10-26T15:11:09.813623Z\n7\t\n8\t## Assumptions\n9\t\n10\t- Human approved the requirement review gate before canonical contract generation.\n11\t"},"output":"1\t# Contract Resolution\n2\t\n3\t- Decision: APPROVE\n4\t- Approved By: human_gate\n5\t- Gate Ref: .agent/workstreams/ws-20261026T142203Z-7SNA/gates/gate-node-gate-human_requirement_review-006.json\n6\t- Created At: 2026-10-26T15:11:09.813623Z\n7\t\n8\t## Assumptions\n9\t\n10\t- Human approved the requirement review gate before canonical contract generation.\n11\t"}}}}],"updated_at":"2026-10-26T15:18:00.232Z","cumulative_token_usage":{"input_tokens":71476,"output_tokens":13752,"cache_creation_input_tokens":0,"cache_read_input_tokens":648512,"total_tokens":733740},"cumulative_cost":{"amount":1.025436,"currency":"USD"},"request_token_usage":{"1f5960c9-8912-4ffc-a2de-f00f38cff5f9":{"input_tokens":71476,"output_tokens":13752,"cache_creation_input_tokens":0,"cache_read_input_tokens":648512,"total_tokens":733740}},"acpx":{"current_model_id":"default","available_models":["default","opus","sonnet","haiku"],"model_control":"config_option","config_options":[{"id":"mode","name":"Mode","description":"Session permission mode","category":"mode","type":"select","currentValue":"default","options":[{"value":"auto","name":"Auto","description":"Use a model classifier to approve/deny permission prompts"},{"value":"default","name":"Manual","description":"Standard behavior, prompts for dangerous operations"},{"value":"acceptEdits","name":"Accept Edits","description":"Auto-accept file edit operations"},{"value":"plan","name":"Plan Mode","description":"Planning mode, no actual tool execution"},{"value":"dontAsk","name":"Don't Ask","description":"Don't prompt for permissions, deny if not pre-approved"},{"value":"bypassPermissions","name":"Bypass Permissions","description":"Bypass all permission checks"}]},{"id":"model","name":"Model","description":"AI model to use","category":"model","type":"select","currentValue":"default","options":[{"value":"default","name":"Default (recommended)","description":"glm-5.3[1m]"},{"value":"opus","name":"glm-5.3","description":"Custom Opus model"},{"value":"sonnet","name":"glm-5.3","description":"Custom Sonnet model"},{"value":"haiku","name":"glm-4.7-air","description":"Custom Haiku model"}]},{"id":"effort","name":"Effort","description":"Available effort levels for this model","category":"thought_level","type":"select","currentValue":"default","options":[{"value":"default","name":"Default"},{"value":"low","name":"Low"},{"value":"medium","name":"Medium"},{"value":"high","name":"High"},{"value":"xhigh","name":"Xhigh"},{"value":"max","name":"Max"}]}],"available_commands":[{"name":"deep-research","description":"Deep research harness — fan-out web searches, fetch sources, adversarially verify claims, synthesize a cited report. (dynamic workflow)","has_input":false},{"name":"design-sync","description":"Push a React design system to claude.ai/design. This runs a converter that bundles the real component code (from Storybook or a bare package) and uploads it. Use when the user runs /design-sync or says \"sync my design system to Claude Design\".","has_input":true},{"name":"dataviz","description":"Use this skill whenever you are about to create ANY chart, graph, plot, dashboard, or data visualization, in ANY output medium — an HTML or React artifact, inline SVG, plotting code in any library (matplotlib, plotly, d3, Recharts, …), an image/PNG you will render and upload, or a chart shared into Slack. Read it BEFORE writing the first line of chart code, choosing chart colors, building a stat tile / meter / KPI row, or laying out a dashboard. Produces visualizations that read as one system — elegant, accessible, consistent in light and dark — using a brand-neutral placeholder palette you swap for your own. Teaches a design-system-agnostic method: a form heuristic, a color formula with a runnable validator, mark specs, and interaction rules. A validated default palette is documented in `references/palette.md` — swap that file's values for your brand's. Triggers on: \"chart\", \"graph\", \"plot\", \"data viz\", \"visualization\", \"dashboard\", \"analytics\", \"visualize data\", \"categorical colors\", \"sequential / diverging palette\", \"stat tile\", \"sparkline\", \"heatmap\", \"legend\", \"axis\", \"tooltip\", \"chart colors\", \"color by series\".","has_input":false},{"name":"update-config","description":"Use this skill to configure the Claude Code harness via settings.json. Automated behaviors (\"from now on when X\", \"each time X\", \"whenever X\", \"before/after X\") require hooks configured in settings.json - the harness executes these, not Claude, so memory/preferences cannot fulfill them. Also use for: permissions (\"allow X\", \"add permission\", \"move permission to\"), env vars (\"set X=Y\"), hook troubleshooting, or any changes to settings.json/settings.local.json files. Examples: \"allow npm commands\", \"add bq permission to global settings\", \"move permission to user settings\", \"set DEBUG=true\", \"when claude stops show X\". For simple settings like theme/model, suggest the /config command.","has_input":false},{"name":"verify","description":"Verify that a code change actually does what it's supposed to by exercising it end-to-end and observing behavior — drive the affected flow, not just tests or typecheck. Run before committing nontrivial changes; bootstraps this repo's project verify skill if none exists yet. Don't invoke it on a diff that only touches tests, docs, or other code with no runtime surface to drive (a change to product source always has one) — there's nothing to observe.","has_input":false},{"name":"debug","description":"Enable debug logging for this session and help diagnose issues","has_input":true},{"name":"code-review","description":"Review the current diff, or a PR number/branch/path target, for correctness bugs and reuse/simplification/efficiency cleanups at the given effort level (low/medium: fewer, high-confidence findings; high→max: broader coverage, may include uncertain findings); with no level given, it reuses the level you typed last. Pass --comment to post findings as inline PR comments, or --fix to apply the findings to the working tree after the review.","has_input":true},{"name":"simplify","description":"Review the changed code for reuse, simplification, efficiency, and altitude cleanups, then apply the fixes. Quality only — it does not hunt for bugs; use /code-review for that.","has_input":true},{"name":"batch","description":"Research and plan a large-scale change, then execute it in parallel across 5–30 isolated worktree agents that each open a PR.","has_input":true},{"name":"fewer-permission-prompts","description":"Scan your transcripts for common read-only Bash and MCP tool calls, then add a prioritized allowlist to project .claude/settings.json to reduce permission prompts.","has_input":false},{"name":"loop","description":"Run a prompt or slash command on a recurring interval (e.g. /loop 5m /foo). Omit the interval to let the model self-pace.","has_input":true},{"name":"claude-api","description":"Reference for the Claude API / Anthropic SDK — model ids, pricing, params, streaming, tool use, MCP, agents, caching, token counting, model migration.\nTRIGGER — read BEFORE opening the target file; don't skip because it \"looks like a one-liner\" — whenever: the prompt names Claude/Anthropic in any form (Claude, Anthropic, Fable, Opus, Sonnet, Haiku, `anthropic`, `@anthropic-ai`, `claude-*`, `us.anthropic.*`, `[1m]`); the user asks about an LLM (pricing/model choice/limits/caching) — never answer from memory; OR the task is LLM-shaped with provider unstated (agent/MCP/tool-definition/multi-agent/RAG/LLM-judge/computer-use; generate/summarize/extract/classify/rewrite/converse over NL; debugging refusals/cutoffs/streaming/tool-calls/tokens).\nSKIP only when another provider is being worked on (overrides all triggers): OpenAI/GPT/Gemini/Llama/Mistral/Cohere/Ollama named in the query; OR `grep -rE 'openai|langchain_openai|google.generativeai|genai|mistralai|cohere|ollama'` over the project hits (run this grep FIRST if no provider named — don't Read the file).","has_input":false},{"name":"run","description":"Launch and drive this project's app to see a change working. Use when asked to run, start, or screenshot the app, or to confirm a change works in the real app (not just tests). First looks for a project skill that already covers launching the app; otherwise falls back to built-in patterns per project type (CLI, server, TUI, Electron, browser-driven, library).","has_input":false},{"name":"run-skill-generator","description":"Author or improve the run-<unit> skill — a per-project skill that tells agents how to build, launch, and drive this project's app. Use when the user asks to set up the project, get it running, write run instructions, or verify build/run steps work from a clean environment.","has_input":false},{"name":"agents","description":"(removed) Ask Claude to create/manage subagents, or edit .claude/agents/","has_input":false},{"name":"auto-mode-setup","description":"Set up and customise auto mode — environment context, plus optional rule tweaks","has_input":true},{"name":"autocompact","description":"Configure the auto-compact window size","has_input":true},{"name":"compact","description":"Free up context by summarizing the conversation so far","has_input":true},{"name":"config","description":"Set a setting by key","has_input":true},{"name":"context","description":"Show current context usage","has_input":false},{"name":"effort","description":"Set effort level for model usage","has_input":true},{"name":"fast","description":"Toggle fast mode (Opus 5)","has_input":true},{"name":"heapdump","description":"Dump the JS heap to ~/Desktop","has_input":false},{"name":"init","description":"Initialize a new CLAUDE.md file with codebase documentation","has_input":false},{"name":"mcp","description":"Manage MCP servers","has_input":true},{"name":"import","description":"Import config from another AI coding agent","has_input":false},{"name":"model","description":"Set the AI model for Claude Code","has_input":true},{"name":"__remote-workflow","description":"Run the workflow script delivered in this session environment (server-launched sessions only)","has_input":false},{"name":"workflow-launch-exec","description":"Execute a server-launched workflow handoff (workflow_launch event sessions only)","has_input":false},{"name":"reload-skills","description":"Pick up skills added or changed on disk during this session","has_input":false},{"name":"rename","description":"Rename the current conversation","has_input":true},{"name":"security-review","description":"Complete a security review of the pending changes on the current branch","has_input":false},{"name":"usage","description":"Show session cost, plan usage, and what's contributing to your limits","has_input":false},{"name":"insights","description":"Generate a report analyzing your Claude Code sessions","has_input":false},{"name":"recap","description":"Generate a one-line session recap now","has_input":false},{"name":"skill-doctor","description":"Show which loaded skills are unused and costing context","has_input":false},{"name":"goal","description":"Set a goal — keep working until the condition is met","has_input":false},{"name":"design","description":"Grant or revoke Claude agent access to your Design projects","has_input":true},{"name":"design-consent","description":"Grant Claude agent access to your Design projects","has_input":false},{"name":"design-revoke","description":"Revoke Claude agent access to your Design projects","has_input":false},{"name":"list-agents","description":"List subagents and other Claude sessions you can message","has_input":false},{"name":"team-onboarding","description":"Help teammates ramp on Claude Code with a guide from your usage","has_input":false}],"session_options":{"allowed_tools":["Read","Grep","Glob"],"claude_execution_policy_ref":".agent/workstreams/ws-20261026T142203Z-7SNA/runs/run-1793027503466/execution-authority/claude-execution-policy.json","claude_execution_policy_sha256":"60439e46902c275c1d57bfd4b291af9b4537e41b2bfdf3852304e6777caeea59"}}}
