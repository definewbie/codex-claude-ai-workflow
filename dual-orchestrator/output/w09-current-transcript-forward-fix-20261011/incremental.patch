+    @Test void delayedCurrentResultIsReadWithinExistingBoundedWait() throws Exception {
+        read("codex", "", "");
+        var writer = new Thread(() -> {
+            try {
+                Thread.sleep(60);
+                Files.writeString(dir.resolve("current.log"), result("3", "", "end_turn", TOKENS));
