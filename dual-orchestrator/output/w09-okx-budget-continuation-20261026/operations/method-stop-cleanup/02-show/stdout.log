atus;\n4\timport app.cryptoincome.assessment.domain.FundingHistoryEvidence;\n5\timport app.cryptoincome.assessment.domain.FundingRatePoint;\n6\timport app.cryptoincome.assessment.domain.PhaseOneAssessment;\n7\timport app.cryptoincome.assessment.domain.PhaseOneAssessmentRequest;\n8\timport app.cryptoincome.assessment.domain.Recommendation;\n9\timport app.cryptoincome.assessment.domain.TerminalPolicy;\n10\timport org.springframework.stereotype.Service;\n11\t\n12\timport java.math.BigDecimal;\n13\timport java.math.MathContext;\n14\timport java.time.Instant;\n15\timport java.util.ArrayList;\n16\timport java.util.Comparator;\n17\timport java.util.List;\n18\timport java.util.Optional;\n19\t\n20\t@Service\n21\tpublic class PhaseOneAssessmentService {\n22\t\n23\t    private static final MathContext CALCULATION_CONTEXT = MathContext.DECIMAL128;\n24\t    private static final BigDecimal DAYS_PER_YEAR = new BigDecimal(\"365\");\n25\t    private static final BigDecimal MAXIMUM_FIRST_LIVE_CAPITAL = new BigDecimal(\"5000\");\n26\t    private static final String EXCHANGE = \"OKX\";\n27\t    private static final String INSTRUMENT = \"BTC-USDT-SWAP\";\n28\t\n29\t    private final FundingRateFactQuery fundingRateFactQuery;\n30\t\n31\t    public PhaseOneAssessmentService(FundingRateFactQuery fundingRateFactQuery) {\n32\t        this.fundingRateFactQuery = fundingRateFactQuery;\n33\t    }\n34\t\n35\t    public PhaseOneAssessment assess(PhaseOneAssessmentRequest request) {\n36\t        List<FundingRatePoint> points = fundingRateFactQuery.findRealizedRates(\n37\t                EXCHANGE, INSTRUMENT, request.from(), request.to(), request.evaluationAsOf());\n38\t        List<FundingRatePoint> ordered = points.stream()\n39\t                .sorted(Comparator.comparing(FundingRatePoint::fundingTime))\n40\t                .toList();\n41\t\n42\t        BigDecimal holdingReturn = ordered.stream()\n43\t                .map(FundingRatePoint::realizedRate)\n44\t                .reduce(BigDecimal.ZERO, BigDecimal::add);\n45\t        BigDecimal fundingIncome = request.hedgedShortNotional().multiply(holdingReturn);\n46\t        BigDecimal simpleEarnIncome = request.candidateCapital()\n47\t                .multiply(request.simpleEarnQuote().apr())\n48\t                .multiply(new BigDecimal(request.simpleEarnQuote().termDays()))\n49\t                .divide(DAYS_PER_YEAR, CALCULATION_CONTEXT);\n50\t        BigDecimal knownCost = request.costs().knownTotal();\n51\t\n52\t        FundingHistoryEvidence history = new FundingHistoryEvidence(\n53\t                holdingReturn,\n54\t                fundingIncome,\n55\t                ordered.size(),\n56\t                (int) ordered.stream().filter(point -> point.realizedRate().signum() > 0).count(),\n57\t                (int) ordered.stream().filter(point -> point.realizedRate().signum() < 0).count(),\n58\t                ordered.stream().map(FundingRatePoint::fundingTime).min(Instant::compareTo),\n59\t                ordered.stream().map(FundingRatePoint::fundingTime).max(Instant::compareTo));\n60\t\n61\t        List<String> blockers = new ArrayList<>();\n62\t        List<String> unknowns = new ArrayList<>(request.costs().unknowns());\n63\t        List<String> reasons = new ArrayList<>();\n64\t        Optional<BigDecimal> netIncome = Optional.empty();\n65\t        Optional<BigDecimal> incremental = Optional.empty();\n66\t        EvidenceStatus evidenceStatus;\n67\t        Recommendation recommendation;\n68\t\n69\t        if (!request.simpleEarnQuote().termsConfirmed()) {\n70\t            blockers.add(\"简单赚币确认页条款尚未人工确认\");\n71\t        }\n72\t        if (ordered.isEmpty()) {\n73\t            blockers.add(\"90 天窗口内没有可用的已实现资金费率事实\");\n74\t        }\n75\t        if (request.terminalPolicy() == TerminalPolicy.KEEP_STRATEGY_OPEN) {\n76\t            unknowns.add(\"期末未退出，无法与到期回到 USDT 的简单赚币同口径比较\");\n77\t        }\n78\t\n79\t        if (!blockers.isEmpty()) {\n80\t            evidenceStatus = EvidenceStatus.INSUFFICIENT;\n