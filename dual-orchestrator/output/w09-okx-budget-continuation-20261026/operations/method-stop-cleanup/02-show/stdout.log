cimal.ZERO))\n34\t                .add(serviceCost.orElse(BigDecimal.ZERO));\n35\t    }\n36\t\n37\t    public boolean complete() {\n38\t        return openingCost.isPresent() && exitCost.isPresent() && slippageCost.isPresent()\n39\t                && rebalanceCost.isPresent() && serviceCost.isPresent();\n40\t    }\n41\t\n42\t    public List<String> unknowns() {\n43\t        List<String> result = new ArrayList<>();\n44\t        if (openingCost.isEmpty()) result.add(\"开仓成本\");\n45\t        if (exitCost.isEmpty()) result.add(\"退出成本\");\n46\t        if (slippageCost.isEmpty()) result.add(\"滑点成本\");\n47\t        if (rebalanceCost.isEmpty()) result.add(\"再平衡成本\");\n48\t        if (serviceCost.isEmpty()) result.add(\"服务/融资成本\");\n49\t        return List.copyOf(result);\n50\t    }\n51\t\n52\t    private static Optional<BigDecimal> requireOptionalCost(Optional<BigDecimal> value, String name) {\n53\t        Objects.requireNonNull(value, name + \"不能为空\");\n54\t        value.ifPresent(cost -> {\n55\t            if (cost.signum() < 0) throw new IllegalArgumentException(name + \"不能为负数\");\n56\t        });\n57\t        return value;\n58\t    }\n59\t}\n60\t"},"output":"1\tpackage app.cryptoincome.assessment.domain;\n2\t\n3\timport java.math.BigDecimal;\n4\timport java.time.Instant;\n5\timport java.util.ArrayList;\n6\timport java.util.List;\n7\timport java.util.Objects;\n8\timport java.util.Optional;\n9\t\n10\tpublic record SmartArbitrageCosts(\n11\t        Instant asOf,\n12\t        String source,\n13\t        Optional<OpeningCost> openingCost,\n14\t        Optional<BigDecimal> exitCost,\n15\t        Optional<BigDecimal> slippageCost,\n16\t        Optional<BigDecimal> rebalanceCost,\n17\t        Optional<BigDecimal> serviceCost\n18\t) {\n19\t    public SmartArbitrageCosts {\n20\t        Objects.requireNonNull(asOf, \"asOf 不能为空\");\n21\t        if (source == null || source.isBlank()) throw new IllegalArgumentException(\"source 不能为空\");\n22\t        openingCost = Objects.requireNonNu