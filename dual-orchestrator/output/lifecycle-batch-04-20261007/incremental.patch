+  private async askExactPermission(
+    params: RequestPermissionRequest,
+    requestId: JsonRpcId,
+    signal: AbortSignal,
+  ): Promise<RequestPermissionResponse> {
+    try {
+      const handler = this.options.onPermissionRequestExact;
+      if (!handler) {
+        return cancelledPermissionResponse();
+      }
+      const attempt = Promise.resolve()
+        .then(
+          async () =>
+            await handler(
+              { sessionId: params.sessionId, raw: params, inferredKind: inferToolKind(params) },
+              { requestId, signal },
+            ),
+        )
+        .then((decision) => ({ kind: "response" as const, decision }));
+      const result = await Promise.race([attempt, waitForAbort(signal)]);
+      if (result.kind !== "response" || !result.decision || !("optionId" in result.decision)) {
+        return cancelledPermissionResponse();
+      }
+      return this.exactOfferedChoice(params, result.decision.optionId);
+    } catch (error) {
+      this.log(
+        `exact permission ask failed; cancelling: ${error instanceof Error ? error.message : String(error)}`,
+      );
+      return cancelledPermissionResponse();
+    }
+  }
+
+  private exactOfferedChoice(
+    params: RequestPermissionRequest,
+    optionId: string,
+  ): RequestPermissionResponse {
+    const option = params.options.find((candidate) => candidate.optionId === optionId);
+    if (!option || !isOncePermissionOption(option)) {
+      return cancelledPermissionResponse();
+    }
+    return { outcome: { outcome: "selected", optionId: option.optionId } };
