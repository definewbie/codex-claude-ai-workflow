+
+export async function handlePermissionReply(
+  explicitAgentName: string | undefined,
+  flags: StatusFlags & { reply: string },
+  command: Command,
+  config: ResolvedAcpxConfig,
+): Promise<void> {
+  const globalFlags = resolveGlobalFlags(command, config);
+  const agent = resolveAgentInvocation(explicitAgentName, globalFlags, config);
+  const reply = parseNativePermissionReply(JSON.parse(flags.reply));
+  if (!reply) {
+    throw new Error("Malformed exact permission reply");
+  }
+  const record = await findSessionByDirectoryWalk({
+    agentCommand: agent.agentCommand,
+    cwd: agent.cwd,
+    name: resolveSessionNameFromFlags(flags, command),
+    boundary: findGitRepositoryRoot(agent.cwd) ?? agent.cwd,
+  });
+  if (!record || record.acpSessionId !== reply.sessionId) {
+    throw new Error("Permission reply has no matching persistent session");
+  }
+  const consumed = await sendNativePermissionReply(record.acpxRecordId, reply);
+  process.stdout.write(
+    `${JSON.stringify({ schema: "dual.native.permission.reply.v1", consumed, requestKey: reply.requestKey, ownerGeneration: reply.ownerGeneration })}\n`,
+  );
+  if (!consumed) {
+    process.exitCode = EXIT_CODES.PERMISSION_DENIED;
+  }
 }
 
