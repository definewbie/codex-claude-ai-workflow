import Path\nfor name in ['src/normalize_text.py','tests/test_normalize_text.py','README.md']:\n print('SHA256',name,hashlib.sha256(Path(name).read_bytes()).hexdigest(),flush=True)\nsys.path.insert(0,str(Path('tests').resolve()))\nimport test_normalize_text as tests\nfor source,expected in tests.CASES:\n actual=tests.normalize_newlines(source)\n print('CASE',repr(source),'EXPECTED',repr(expected),'ACTUAL',repr(actual),'IDEMPOTENT',tests.normalize_newlines(actual)==actual,flush=True)\n assert actual==expected\nsuite=unittest.defaultTestLoader.discover('tests')\nresult=unittest.TextTestRunner(verbosity=2,stream=sys.stdout).run(suite)\nprint('COUNTS',result.testsRun,'failures',len(result.failures),'errors',len(result.errors),flush=True)\nassert result.wasSuccessful()\ndoc=doctest.testfile('README.md',module_relative=False,verbose=True)\nassert doc.failed==0 and doc.attempted==5\nPY","raw_input":"{\"command\":\"rtk proxy python3 -B - <<'PY'\\nimport sys, unittest, doctest, hashlib\\nfrom pathlib import Path\\nfor name in ['src/normalize_text.py','tests/test_normalize_text.py','README.md']:\\n print('SHA256',name,hashlib.sha256(Path(name).read_bytes()).hexdigest(),flush=True)\\nsys.path.insert(0,str(Path('tests').resolve()))\\nimport test_normalize_text as tests\\nfor source,expected in tests.CASES:\\n actual=tests.normalize_newlines(source)\\n print('CASE',repr(source),'EXPECTED',repr(expected),'ACTUAL',repr(actual),'IDEMPOTENT',tests.normalize_newlines(actual)==actual,flush=True)\\n assert actual==expected\\nsuite=unittest.defaultTestLoader.discover('tests')\\nresult=unittest.TextTestRunner(verbosity=2,stream=sys.stdout).run(suite)\\nprint('COUNTS',result.testsRun,'failures',len(result.failures),'errors',len(result.errors),flush=True)\\nassert result.wasSuccessful()\\ndoc=doctest.testfile('README.md',module_relative=False,verbose=True)\\nassert doc.failed==0 and doc.attempted==5\\nPY\",\"cwd\":\"/Users/kriswang/work/projects/ai/codex-claude-ai-workflow/dual-orchestrato