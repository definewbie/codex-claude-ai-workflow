pty(self):\\n35\\t        self.assertEqual(CASES[0], (\\\"\\\", \\\"\\\"))\\n36\\t        self.assertEqual(normalize_newlines(CASES[0][0]), CASES[0][1])\\n37\\t\\n38\\t    def test_pure_lf_unchanged(self):\\n39\\t        self.assertEqual(CASES[1], (\\\"a\\\\nb\\\\n\\\", \\\"a\\\\nb\\\\n\\\"))\\n40\\t        self.assertEqual(normalize_newlines(CASES[1][0]), CASES[1][1])\\n41\\t\\n42\\t    def test_crlf_becomes_single_lf(self):\\n43\\t        self.assertEqual(CASES[2], (\\\"a\\\\r\\\\nb\\\", \\\"a\\\\nb\\\"))\\n44\\t        # 锁定替换顺序：先合并 CRLF 再处理孤立 CR，CRLF 不得拆成两个 LF。\\n45\\t        self.assertEqual(normalize_newlines(\\\"a\\\\r\\\\nb\\\"), \\\"a\\\\nb\\\")\\n46\\t        self.assertNotEqual(normalize_newlines(\\\"a\\\\r\\\\nb\\\"), \\\"a\\\\n\\\\nb\\\")\\n47\\t\\n48\\t    def test_lone_cr_becomes_lf(self):\\n49\\t        self.assertEqual(CASES[3], (\\\"a\\\\rb\\\", \\\"a\\\\nb\\\"))\\n50\\t        self.assertEqual(normalize_newlines(CASES[3][0]), CASES[3][1])\\n51\\t\\n52\\t    def test_mixed_newlines_normalized(self):\\n53\\t        self.assertEqual(CASES[4], (\\\"a\\\\r\\\\nb\\\\rc\\\\nd\\\", \\\"a\\\\nb\\\\nc\\\\nd\\\"))\\n54\\t        self.assertEqual(normalize_newlines(CASES[4][0]), CASES[4][1])\\n55\\t\\n56\\t    def test_unicode_and_line_separators_preserved(self):\\n57\\t        self.assertEqual(CASES[5], (\\\"中文\\\\u2028\\uD83D\\uDE00\\\\r\\\\nx\\\", \\\"中文\\\\u2028\\uD83D\\uDE00\\\\nx\\\"))\\n58\\t        result = normalize_newlines(CASES[5][0])\\n59\\t        self.assertEqual(result, CASES[5][1])\\n60\\t        self.assertIn(\\\"\\\\u2028\\\", result)  # U+2028 保留，不做转换\\n61\\t\\n62\\t    def test_trailing_newline_present_kept(self):\\n63\\t        self.assertEqual(CASES[6], (\\\"end\\\\r\\\\n\\\", \\\"end\\\\n\\\"))\\n64\\t        result = normalize_newlines(CASES[6][0])\\n65\\t        self.assertEqual(result, CASES[6][1])\\n66\\t        self.assertTrue(result.endswith(\\\"\\\\n\\\"))\\n67\\t\\n68\\t    def test_trailing_newline_absent_kept(self):\\n69\\t   