{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"b69c3b34-54cb-4c82-bcb6-84d71115504c","update":{"_meta":{"claudeCode":{"toolResponse":{"type":"text","file":{"filePath":"/Users/kriswang/work/projects/ai/codex-claude-ai-workflow/dual-orchestrator/output/w09-fixtures/eighth-20261023/worktree/tests/test_normalize_text.py","content":"\"\"\"normalize_newlines 的 unittest 测试。\n\n在仓库根目录执行：python -m unittest discover -s tests -v\n（unittest 默认将逐用例行与 Ran/OK 摘要写入 stderr，保存完整输出可用 2>&1 合并。）\n\"\"\"\n\nimport sys\nimport unittest\nfrom pathlib import Path\n\n# 定位仓库 src/ 目录并注入 sys.path（不存在时才插入），支持从仓库根直接运行。\nSRC_DIR = Path(__file__).resolve().parents[1] / \"src\"\nif str(SRC_DIR) not in sys.path:\n    sys.path.insert(0, str(SRC_DIR))\n\n# normalize_text 位于 src/ 下，导入须在 sys.path 注入之后（故 noqa: E402）。\nfrom normalize_text import normalize_newlines  # noqa: E402\n\n# 共享 CASES 表：九类输入 → 期望输出。\nCASES = [\n    (\"\", \"\"),                          # 空串\n    (\"a\\nb\\n\", \"a\\nb\\n\"),              # 纯 LF，原样保留\n    (\"a\\r\\nb\", \"a\\nb\"),                # CRLF → 单个 LF\n    (\"a\\rb\", \"a\\nb\"),                  # 孤立 CR → LF\n    (\"a\\r\\nb\\rc\\nd\", \"a\\nb\\nc\\nd\"),    # 混合换行\n    (\"中文\\u2028😀\\r\\nx\", \"中文\\u2028😀\\nx\"),  # Unicode，U+2028 保留\n    (\"end\\r\\n\", \"end\\n\"),              # 末尾有换行，保留\n    (\"no newline\", \"no newline\"),      # 末尾无换行，不新增\n    (\"a\\r\\n\\r\\n\\rb\", \"a\\n\\n\\nb\"),      # 连续空行\n]\n\n\nclass TestNormalizeNewlines(unittest.TestCase):\n    def test_empty_string_returns_empty(self):\n        self.assertEqual(CASES[0], (\"\", \"\"))\n        self.assertEqual(normalize_newlines(CASES[0][0]), CASES[0][1])\n\n    def test_pure_lf_unchanged(self):\n        self.assertEqual(CASES[1], (\"a\\nb\\n\", \"a\\nb\\n\"))\n        self.assertEqual(normalize_newlines(CASES[1][0]), CASES[1][1])\n\n    def test_crlf_becomes_single_lf(self):\n        self.assertEqual(CASES[2], (\"a\\r\\nb\", \"a\\nb\"))\n        # 锁定替换顺序：先合并 CRLF 再处理孤立 CR，CRLF 不得拆成两个 LF。\n        self.assertEqual(normalize_newlines(\"a\\r\\nb\"), \"a\\nb\")\n        self.assertNotEqual(normalize_newlines(\"a\\r\\nb\"), \"a\\n\\nb\")\n\n    def test_lone_cr_becomes_lf(self):\n        self.assertEqual(CASES[3], (\"a\\rb\", \"a\\nb\"))\n        self.assertEqual(normalize_newlines(CASES[3][0]), CASES[3][1])\n\n    def test_mixed_newlines_normalized(self):\n        self.assertEqual(CASES[4], (\"a\\r\\nb\\rc\\nd\", \"a\\nb\\nc\\nd\"))\n        self.assertEqual(normalize_newlines(CASES[4][0]), CASES[4][1])\n\n    def test_unicode_and_line_separators_preserved(self):\n        self.assertEqual(CASES[5], (\"中文\\u2028😀\\r\\nx\", \"中文\\u2028😀\\nx\"))\n        result = normalize_newlines(CASES[5][0])\n        self.assertEqual(result, CASES[5][1])\n        self.assertIn(\"\\u2028\", result)  # U+2028 保留，不做转换\n\n    def test_trailing_newline_present_kept(self):\n        self.assertEqual(CASES[6], (\"end\\r\\n\", \"end\\n\"))\n        result = normalize_newlines(CASES[6][0])\n        self.assertEqual(result, CASES[6][1])\n        self.assertTrue(result.endswith(\"\\n\"))\n\n    def test_trailing_newline_absent_kept(self):\n        self.assertEqual(CASES[7], (\"no newline\", \"no newline\"))\n        result = normalize_newlines(CASES[7][0])\n        self.assertEqual(result, CASES[7][1])\n        self.assertFalse(result.endswith(\"\\n\"))\n\n    def test_consecutive_blank_lines_normalized(self):\n        self.assertEqual(CASES[8], (\"a\\r\\n\\r\\n\\rb\", \"a\\n\\n\\nb\"))\n        self.assertEqual(normalize_newlines(CASES[8][0]), CASES[8][1])\n\n    def test_no_cr_left_in_output(self):\n        for source, _expected in CASES:\n            with self.subTest(source=source):\n                self.assertNotIn(\"\\r\", normalize_newlines(source))\n\n    def test_idempotent_across_all_cases(self):\n        for source, _expected in CASES:\n            with self.subTest(source=source):\n                once = normalize_newlines(source)\n                self.assertEqual(normalize_newlines(once), once)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","numLines":92,"startLine":1,"totalLines":92}},"toolName":"Read"}},"toolCallId":"call_850de6e8b4bf4def9c3c46e6","sessionUpdate":"tool_call_update"}}}
{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"b69c3b34-54cb-4c82-bcb6-84d71115504c","update":{"_meta":{"claudeCode":{"toolName":"Read"}},"toolCallId":"call_850de6e8b4bf4def9c3c46e6","sessionUpdate":"tool_call_update","status":"completed","rawOutput":"1\t\"\"\"normalize_newlines 的 unittest 测试。\n2\t\n3\t在仓库根目录执行：python -m unittest discover -s tests -v\n4\t（unittest 默认将逐用例行与 Ran/OK 摘要写入 stderr，保存完整输出可用 2>&1 合并。）\n5\t\"\"\"\n6\t\n7\timport sys\n8\timport unittest\n9\tfrom pathlib import Path\n10\t\n11\t# 定位仓库 src/ 目录并注入 sys.path（不存在时才插入），支持从仓库根直接运行。\n12\tSRC_DIR = Path(__file__).resolve().parents[1] / \"src\"\n13\tif str(SRC_DIR) not in sys.path:\n14\t    sys.path.insert(0, str(SRC_DIR))\n15\t\n16\t# normalize_text 位于 src/ 下，导入须在 sys.path 注入之后（故 noqa: E402）。\n17\tfrom normalize_text import normalize_newlines  # noqa: E402\n18\t\n19\t# 共享 CASES 表：九类输入 → 期望输出。\n20\tCASES = [\n21\t    (\"\", \"\"),                          # 空串\n22\t    (\"a\\nb\\n\", \"a\\nb\\n\"),              # 纯 LF，原样保留\n23\t    (\"a\\r\\nb\", \"a\\nb\"),                # CRLF → 单个 LF\n24\t    (\"a\\rb\", \"a\\nb\"),                  # 孤立 CR → LF\n25\t    (\"a\\r\\nb\\rc\\nd\", \"a\\nb\\nc\\nd\"),    # 混合换行\n26\t    (\"中文\\u2028😀\\r\\nx\", \"中文\\u2028😀\\nx\"),  # Unicode，U+2028 保留\n27\t    (\"end\\r\\n\", \"end\\n\"),              # 末尾有换行，保留\n28\t    (\"no newline\", \"no newline\"),      # 末尾无换行，不新增\n29\t    (\"a\\r\\n\\r\\n\\rb\", \"a\\n\\n\\nb\"),      # 连续空行\n30\t]\n31\t\n32\t\n33\tclass TestNormalizeNewlines(unittest.TestCase):\n34\t    def test_empty_string_returns_empty(self):\n35\t        self.assertEqual(CASES[0], (\"\", \"\"))\n36\t        self.assertEqual(normalize_newlines(CASES[0][0]), CASES[0][1])\n37\t\n38\t    def test_pure_lf_unchanged(self):\n39\t        self.assertEqual(CASES[1], (\"a\\nb\\n\", \"a\\nb\\n\"))\n40\t        self.assertEqual(normalize_newlines(CASES[1][0]), CASES[1][1])\n41\t\n42\t    def test_crlf_becomes_single_lf(self):\n43\t        self.assertEqual(CASES[2], (\"a\\r\\nb\", \"a\\nb\"))\n44\t        # 锁定替换顺序：先合并 CRLF 再处理孤立 CR，CRLF 不得拆成两个 LF。\n45\t        self.assertEqual(normalize_newlines(\"a\\r\\nb\"), \"a\\nb\")\n46\t        self.assertNotEqual(normalize_newlines(\"a\\r\\nb\"), \"a\\n\\nb\")\n47\t\n48\t    def test_lone_cr_becomes_lf(self):\n49\t        self.assertEqual(CASES[3], (\"a\\rb\", \"a\\nb\"))\n50\t        self.assertEqual(normalize_newlines(CASES[3][0]), CASES[3][1])\n51\t\n52\t    def test_mixed_newlines_normalized(self):\n53\t        self.assertEqual(CASES[4], (\"a\\r\\nb\\rc\\nd\", \"a\\nb\\nc\\nd\"))\n54\t        self.assertEqual(normalize_newlines(CASES[4][0]), CASES[4][1])\n55\t\n56\t    def test_unicode_and_line_separators_preserved(self):\n57\t        self.assertEqual(CASES[5], (\"中文\\u2028😀\\r\\nx\", \"中文\\u2028😀\\nx\"))\n58\t        result = normalize_newlines(CASES[5][0])\n59\t        self.assertEqual(result, CASES[5][1])\n60\t        self.assertIn(\"\\u2028\", result)  # U+2028 保留，不做转换\n61\t\n62\t    def test_trailing_newline_present_kept(self):\n63\t        self.assertEqual(CASES[6], (\"end\\r\\n\", \"end\\n\"))\n64\t        result = normalize_newlines(CASES[6][0])\n65\t        self.assertEqual(result, CASES[6][1])\n66\t        self.assertTrue(result.endswith(\"\\n\"))\n67\t\n68\t    def test_trailing_newline_absent_kept(self):\n69\t        self.assertEqual(CASES[7], (\"no newline\", \"no newline\"))\n70\t        result = normalize_newlines(CASES[7][0])\n71\t        self.assertEqual(result, CASES[7][1])\n72\t        self.assertFalse(result.endswith(\"\\n\"))\n73\t\n74\t    def test_consecutive_blank_lines_normalized(self):\n75\t        self.assertEqual(CASES[8], (\"a\\r\\n\\r\\n\\rb\", \"a\\n\\n\\nb\"))\n76\t        self.assertEqual(normalize_newlines(CASES[8][0]), CASES[8][1])\n77\t\n78\t    def test_no_cr_left_in_output(self):\n79\t        for source, _expected in CASES:\n80\t            with self.subTest(source=source):\n81\t                self.assertNotIn(\"\\r\", normalize_newlines(source))\n82\t\n83\t    def test_idempotent_across_all_cases(self):\n84\t        for source, _expected in CASES:\n85\t            with self.subTest(source=source):\n86\t                once = normalize_newlines(source)\n87\t                self.assertEqual(normalize_newlines(once), once)\n88\t\n89\t\n90\tif __name__ == \"__main__\":\n91\t    unittest.main()\n92\t","content":[{"type":"content","content":{"type":"text","text":"```\n1\t\"\"\"normalize_newlines 的 unittest 测试。\n2\t\n3\t在仓库根目录执行：python -m unittest discover -s tests -v\n4\t（unittest 默认将逐用例行与 Ran/OK 摘要写入 stderr，保存完整输出可用 2>&1 合并。）\n5\t\"\"\"\n6\t\n7\timport sys\n8\timport unittest\n9\tfrom pathlib import Path\n10\t\n11\t# 定位仓库 src/ 目录并注入 sys.path（不存在时才插入），支持从仓库根直接运行。\n12\tSRC_DIR = Path(__file__).resolve().parents[1] / \"src\"\n13\tif str(SRC_DIR) not in sys.path:\n14\t    sys.path.insert(0, str(SRC_DIR))\n15\t\n16\t# normalize_text 位于 src/ 下，导入须在 sys.path 注入之后（故 noqa: E402）。\n17\tfrom normalize_text import normalize_newlines  # noqa: E402\n18\t\n19\t# 共享 CASES 表：九类输入 → 期望输出。\n20\tCASES = [\n21\t    (\"\", \"\"),                          # 空串\n22\t    (\"a\\nb\\n\", \"a\\nb\\n\"),              # 纯 LF，原样保留\n23\t    (\"a\\r\\nb\", \"a\\nb\"),                # CRLF → 单个 LF\n24\t    (\"a\\rb\", \"a\\nb\"),                  # 孤立 CR → LF\n25\t    (\"a\\r\\nb\\rc\\nd\", \"a\\nb\\nc\\nd\"),    # 混合换行\n26\t    (\"中文\\u2028😀\\r\\nx\", \"中文\\u2028😀\\nx\"),  # Unicode，U+2028 保留\n27\t    (\"end\\r\\n\", \"end\\n\"),              # 末尾有换行，保留\n28\t    (\"no newline\", \"no newline\"),      # 末尾无换行，不新增\n29\t    (\"a\\r\\n\\r\\n\\rb\", \"a\\n\\n\\nb\"),      # 连续空行\n30\t]\n31\t\n32\t\n33\tclass TestNormalizeNewlines(unittest.TestCase):\n34\t    def test_empty_string_returns_empty(self):\n35\t        self.assertEqual(CASES[0], (\"\", \"\"))\n36\t        self.assertEqual(normalize_newlines(CASES[0][0]), CASES[0][1])\n37\t\n38\t    def test_pure_lf_unchanged(self):\n39\t        self.assertEqual(CASES[1], (\"a\\nb\\n\", \"a\\nb\\n\"))\n40\t        self.assertEqual(normalize_newlines(CASES[1][0]), CASES[1][1])\n41\t\n42\t    def test_crlf_becomes_single_lf(self):\n43\t        self.assertEqual(CASES[2], (\"a\\r\\nb\", \"a\\nb\"))\n44\t        # 锁定替换顺序：先合并 CRLF 再处理孤立 CR，CRLF 不得拆成两个 LF。\n45\t        self.assertEqual(normalize_newlines(\"a\\r\\nb\"), \"a\\nb\")\n46\t        self.assertNotEqual(normalize_newlines(\"a\\r\\nb\"), \"a\\n\\nb\")\n47\t\n48\t    def test_lone_cr_becomes_lf(self):\n49\t        self.assertEqual(CASES[3], (\"a\\rb\", \"a\\nb\"))\n50\t        self.assertEqual(normalize_newlines(CASES[3][0]), CASES[3][1])\n51\t\n52\t    def test_mixed_newlines_normalized(self):\n53\t        self.assertEqual(CASES[4], (\"a\\r\\nb\\rc\\nd\", \"a\\nb\\nc\\nd\"))\n54\t        self.assertEqual(normalize_newlines(CASES[4][0]), CASES[4][1])\n55\t\n56\t    def test_unicode_and_line_separators_preserved(self):\n57\t        self.assertEqual(CASES[5], (\"中文\\u2028😀\\r\\nx\", \"中文\\u2028😀\\nx\"))\n58\t        result = normalize_newlines(CASES[5][0])\n59\t        self.assertEqual(result, CASES[5][1])\n60\t        self.assertIn(\"\\u2028\", result)  # U+2028 保留，不做转换\n61\t\n62\t    def test_trailing_newline_present_kept(self):\n63\t        self.assertEqual(CASES[6], (\"end\\r\\n\", \"end\\n\"))\n64\t        result = normalize_newlines(CASES[6][0])\n65\t        self.assertEqual(result, CASES[6][1])\n66\t        self.assertTrue(result.endswith(\"\\n\"))\n67\t\n68\t    def test_trailing_newline_absent_kept(self):\n69\t        self.assertEqual(CASES[7], (\"no newline\", \"no newline\"))\n70\t        result = normalize_newlines(CASES[7][0])\n71\t        self.assertEqual(result, CASES[7][1])\n72\t        self.assertFalse(result.endswith(\"\\n\"))\n73\t\n74\t    def test_consecutive_blank_lines_normalized(self):\n75\t        self.assertEqual(CASES[8], (\"a\\r\\n\\r\\n\\rb\", \"a\\n\\n\\nb\"))\n76\t        self.assertEqual(normalize_newlines(CASES[8][0]), CASES[8][1])\n77\t\n78\t    def test_no_cr_left_in_output(self):\n79\t        for source, _expected in CASES:\n80\t            with self.subTest(source=source):\n81\t                self.assertNotIn(\"\\r\", normalize_newlines(source))\n82\t\n83\t    def test_idempotent_across_all_cases(self):\n84\t        for source, _expected in CASES:\n85\t            with self.subTest(source=source):\n86\t                once = normalize_newlines(source)\n87\t                self.assertEqual(normalize_newlines(once), once)\n88\t\n89\t\n90\tif __name__ == \"__main__\":\n91\t    unittest.main()\n```"}}]}}}
