+export function resolveAutomaticPermissionRequest(
+  params: RequestPermissionRequest,
+  mode: PermissionMode,
+  policy?: PermissionPolicy,
+): ResolvedPermissionRequest | undefined {
+  const options = params.options ?? [];
+  if (options.length === 0) {
+    return { response: cancelled() };
+  }
+  const allow = pickOption(options, ["allow_once", "allow_always"]);
+  const reject = pickOption(options, ["reject_once", "reject_always"]);
+  const match = matchPermissionPolicy(params, policy);
+  if (match) {
+    return resolveAutomaticPolicyChoice(match.action, options, allow, reject);
+  }
+  return resolveModeMatch(options, mode, allow, reject) ?? automaticReadChoice(params, allow);
+}
+
+function resolveAutomaticPolicyChoice(
+  action: "approve" | "deny" | "escalate",
+  options: RequestPermissionRequest["options"],
+  allow: RequestPermissionRequest["options"][number] | undefined,
+  reject: RequestPermissionRequest["options"][number] | undefined,
+): ResolvedPermissionRequest | undefined {
+  if (action === "approve") {
+    return selectedOrFirst(options, allow);
+  }
+  if (action === "deny") {
+    return selectedOrCancelled(reject);
+  }
+  return undefined;
+}
+function automaticReadChoice(
+  params: RequestPermissionRequest,
+  allow: RequestPermissionRequest["options"][number] | undefined,
+): ResolvedPermissionRequest | undefined {
+  return isAutoApprovedReadKind(inferToolKind(params)) && allow
+    ? { response: selected(allow.optionId) }
+    : undefined;
+}
